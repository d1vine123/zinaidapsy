# Copy to /srv/zinaidapsy/private/production.env and chmod 0600.
# Plain KEY=value syntax, shared by systemd and python-dotenv; do not use export.
# Replace SECRET_KEY with a newly generated random value before starting.
SECRET_KEY=REPLACE_WITH_A_NEW_RANDOM_SECRET
DEBUG=False
ALLOWED_HOSTS=zinaidapsy.ru,www.zinaidapsy.ru
CSRF_TRUSTED_ORIGINS=https://zinaidapsy.ru,https://www.zinaidapsy.ru
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
WAGTAIL_SITE_NAME="Zinaida Psy"
WAGTAILADMIN_BASE_URL=https://zinaidapsy.ru
PUBLIC_SITE_URL=https://zinaidapsy.ru
DB_ENGINE=sqlite
DB_NAME=/srv/zinaidapsy/private/db.sqlite3

# Fill privately from the retained .env. No real credentials belong in this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GOOGLE_FORM_ID=
GOOGLE_ENTRY_NAME=
GOOGLE_ENTRY_PHONE=
GOOGLE_ENTRY_MESSAGE=
GOOGLE_ENTRY_SOURCE=
GOOGLE_ENTRY_CONTACT_METHOD=
GOOGLE_ENTRY_TELEGRAM_USERNAME=
FEEDBACK_DELIVERY_TIMEOUT=10
FEEDBACK_DELIVERY_MAX_ATTEMPTS=24
FEEDBACK_RETRY_INITIAL_SECONDS=60
FEEDBACK_RETRY_MAX_SECONDS=3600
